{
  "manifest_version": 3,
  "name": "Instagram Reel Rotator",
  "version": "1.0",
  "description": "Rotate landscape Instagram Reels on desktop for a better viewing experience",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
